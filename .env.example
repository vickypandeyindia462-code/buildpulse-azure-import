# Agent runtime: works without any cloud credentials in mock mode.
LLM_PROVIDER=mock
CI_SOURCE=fixture

# Gemini live assistance (set LLM_PROVIDER=gemini; keep the real key only in .env)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
GEMINI_EMBEDDING_MODEL=gemini-embedding-001

# OpenAI Responses API (set LLM_PROVIDER=openai)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
# Optional OpenAI-compatible gateway endpoint
OPENAI_BASE_URL=

# Anthropic Messages API (set LLM_PROVIDER=anthropic)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-5
ANTHROPIC_BASE_URL=https://api.anthropic.com

# Azure AI Foundry (hackathon-day values; use the Azure deployment names, not assumed model IDs)
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_API_VERSION=
AZURE_OPENAI_CHAT_DEPLOYMENT=
AZURE_OPENAI_EMBEDDING_DEPLOYMENT=

# Postgres
POSTGRES_USER=buildpulse
POSTGRES_PASSWORD=changeme
POSTGRES_DB=buildpulse
DATABASE_URL=postgresql+psycopg://buildpulse:changeme@postgres:5432/buildpulse
EMBEDDING_DIM=1536

# App
ENV=development
LOG_LEVEL=INFO

# Repository Intelligence (read-only local synthetic repository for the demo)
DEMO_SERVICES_REPO_PATH=C:\Users\Vijay\OneDrive\Documents\buildpulse-demo-services

# GitHub integration
# Copy this file to .env and set the GITHUB_TOKEN value (do NOT commit the real token)
# Example: GITHUB_TOKEN=your_read_only_github_token
GITHUB_TOKEN=
GITHUB_OWNER=vickypandeyindia462-code
GITHUB_REPO=buildpulse-demo-services

# Jira Cloud dashboard intelligence (keep real credentials only in .env)
JIRA_BASE_URL=
JIRA_PROJECT_KEY=
JIRA_EMAIL=
JIRA_API_TOKEN=

# Confluence knowledge source (can be hosted on a different Atlassian site)
CONFLUENCE_BASE_URL=
CONFLUENCE_SPACE_ID=
CONFLUENCE_SPACE_KEY=
