# Azure AI Foundry
AZURE_AI_ENDPOINT=
AZURE_AI_API_KEY=
AZURE_AI_CHAT_MODEL=
AZURE_AI_EMBEDDING_MODEL=

# Postgres
POSTGRES_USER=buildpulse
POSTGRES_PASSWORD=changeme
POSTGRES_DB=buildpulse
DATABASE_URL=postgresql://buildpulse:changeme@postgres:5432/buildpulse

# App
ENV=development
LOG_LEVEL=INFO

# GitHub integration
# Copy this file to .env and set the GITHUB_TOKEN value (do NOT commit the real token)
# Example: GITHUB_TOKEN=ghp_xxx_your_personal_access_token_here
GITHUB_TOKEN=
GITHUB_REPO=
